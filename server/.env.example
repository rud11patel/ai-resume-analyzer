# ==============================================================================
# AI Resume Analyzer - Backend Environment Variables
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/ai_resume_analyzer
# MongoDB Atlas (example):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_resume_analyzer?retryWrites=true&w=majority

# Client Application URL (used for CORS whitelist)
CLIENT_URL=http://localhost:5173

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Python AI & Document Processing Microservice URL
PYTHON_SERVICE_URL=http://localhost:8000

# Express Request Body Size Limit
REQUEST_LIMIT=10mb

# ==============================================================================
# LLM Career Advisor (Primary: Groq LPU, Automatic Fallback: Google Gemini)
# ==============================================================================
# Primary Provider: Groq (API key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Fallback Provider: Google Gemini (API key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Maximum timeout in milliseconds before falling back or continuing
LLM_TIMEOUT_MS=25000
